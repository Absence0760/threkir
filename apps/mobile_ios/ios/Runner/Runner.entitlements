<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- APNs. Resolved from the per-configuration APS_ENVIRONMENT build setting
	     (Debug + Profile `development`, Release `production`) rather than
	     hardcoded, because one entitlements file serves all three configurations
	     and the sandbox and production APNs hosts reject each other's tokens.
	     Pinning `development` here and trusting the distribution export to
	     rewrite it is the shape that ships a TestFlight build whose tokens the
	     worker's production host answers BadDeviceToken for — push that never
	     arrives and never errors. An undefined setting expands to the literal
	     string, which no profile carries, so the failure is loud at signing.
	     decisions.md § 742. -->
	<key>com.apple.developer.aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- Shared container the Share Extension writes a shared route file into
	     and this app reads it back out of. Deliberately a second group rather
	     than the watch complication's `group.com.threkir.app.activerun`: the
	     extension clears this container's root on every activation, which
	     would be destructive to a group holding anything else. Both this
	     file and ShareExtension.entitlements must carry it, and the id must
	     match Info.plist's AppGroupId and SharedRouteHandoff.appGroup. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.threkir.app.share</string>
	</array>
</dict>
</plist>
