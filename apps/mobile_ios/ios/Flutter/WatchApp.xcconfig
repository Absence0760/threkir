// App Store upload rejects an .ipa whose embedded watch app does not carry the
// same CFBundleShortVersionString / CFBundleVersion as its companion, so the
// watch target reads Flutter's version rather than a second literal. Only
// Generated.xcconfig is included: the Pods xcconfigs Debug/Release.xcconfig
// pull in are iOS-only and would not link on watchOS.
#include "Generated.xcconfig"

MARKETING_VERSION=$(FLUTTER_BUILD_NAME)
CURRENT_PROJECT_VERSION=$(FLUTTER_BUILD_NUMBER)

// The watch's Supabase project. Info.plist expands SupabaseURL /
// SupabaseAnonKey from these two settings, and nothing else defines them:
// Flutter hands `--dart-define-from-file` to Xcode only as DART_DEFINES, which
// no watchOS code decodes. release-ios.yml writes this untracked file from the
// release secrets (scripts/ios_watch_runtime_config.mjs) and then checks the
// shipped WatchApp.app/Info.plist holds both. Absent, both expand to empty and
// the watch's sign-in is fail-closed, which is the right state for a build
// nobody configured (decisions § 1810).
#include? "WatchRuntime.xcconfig"
