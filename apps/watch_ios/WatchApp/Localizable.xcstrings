    "%@ to go": {
      "comment": "Distance remaining on the armed route during a run; the placeholder already carries its unit. Wording matches Wear OS's distance_km_to_go.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "noch %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restantes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restants"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "faltam %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "faltam %@"
          }
        }
      }
    },
    "%@. %@": {
      "comment": "Sentence break between a split's distance and its pace tail. Localised because the break itself differs — ja joins with a full-width stop and no space. Mirrors the phone's ttsSplit and Wear's tts_split_phrase.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。%2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        }
      }
    },
    "%@. %@ at %@.": {
      "comment": "Spoken step announcement for a paced distance step: step name, distance, target pace. Matches the phone's ttsStepDistancePace in apps/mobile_android/lib/l10n/app_*.arb.",
