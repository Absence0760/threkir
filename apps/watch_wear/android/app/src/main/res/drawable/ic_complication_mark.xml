<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome Threkir mark for the watch-face complication. The glyph is the
  launcher icon's white thorn mark from apps/web/static/logo-mark.svg, lifted
  out of its 1024 px canvas (the SVG draws it at translate(-54.5 -50) in a
  local 100-unit space) and recentred in a 100-unit viewport. Watch faces
  tint a MonochromaticImage themselves, so the fill colour only matters as
  an alpha mask. The middle sub-path is cut out of the bowl by evenOdd, the
  same fill-rule the SVG uses.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <group android:translateX="-4.5">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M30,10 H44 V90 H30 Z M44,29 H58 A21,21 0 0 1 58,71 H44 Z M44,42 H56 A8,8 0 0 1 56,58 H44 Z" />
    </group>
</vector>
