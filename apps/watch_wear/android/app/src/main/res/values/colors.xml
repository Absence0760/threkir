<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Background colour for the adaptive launcher icon. Picked to match
      the dominant coral of the foreground PNG so the masked edge blends
      seamlessly when Wear OS crops the icon to a circle. Tune toward
      the exact PNG colour if a designer revisits the brand mark.
    -->
    <!-- Matches the launcher PNG's own coral edge, NOT the UI palette:
         the adaptive icon's mask edge blends into this colour, so it moves
         only when assets/icon.svg does (a wrong hex shows as a halo). -->
    <color name="ic_launcher_background">#D97A54</color>
</resources>
