        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@ bei %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@ a %3$@."
          }
        },
        "fr": {
          "stringUnit": {
