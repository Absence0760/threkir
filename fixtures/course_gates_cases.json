 "schema": {
  "general": [
   "Every reader loads this whole file and runs every case in every section below, and fails on a section it does not know; a section a reader skips is a rule that side no longer has to keep.",
   "A field documented as nullable is present with the JSON value null when absent; readers must not treat a missing key as null.",
   "degreeTolerance applies to every compared latitude or longitude, bearingTolerance to every compared bearing, distanceToleranceM to every compared distance. Every other comparison is exact.",
   "Every expected value is hand-computed in the case's note from R = 6371008.8 m (one metre is 8.993203637e-6 degrees of latitude, and of longitude on the equator), never copied from a port."
  ],
  "constants": "The helper's named constants; each reader asserts its own values equal these.",
  "normalizeBearing": "{in, out}: any finite bearing into [0, 360).",
  "clampHalfWidth": "{in, out}: held to [halfWidthMinM, halfWidthMaxM], rounded to the metre; a non-finite input gives defaultHalfWidthM.",
  "courseGate": "{row, which, expected}: row holds the ten line columns (sources may be absent, which reads as derived); expected is null or {lat, lng, bearingDeg, halfWidthM, source}.",
  "bearingTo": "{from, to, bearingDeg}.",
  "lineEnds": "{gate, left, right}: the line's ends, left of travel first.",
  "arrowTip": "{gate, tip}.",
  "routeRelation": "{gate, route, expected}: expected is null or {distanceM, routeBearingDeg, against}.",
  "warnings": "{which, gate, route, selfCross, mode, expected}: gate and route are nullable; expected is the warning codes in order.",
  "preflight": "{mode, courses, expected}: each course {id, startGate, finishGate, hasFinishPoint, selfCross, route}, gates nullable and carrying a source; expected is the issues in order, each {courseId, code, severity, which} with which null except on gate_far_from_route; blocks is preflightBlocks of the result."
 },
 "degreeTolerance": 1e-09,
 "bearingTolerance": 1e-06,
