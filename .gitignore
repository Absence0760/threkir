# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.pub-cache/
.pub/
# pubspec.lock is COMMITTED. These are applications, not libraries, so the
# lockfile is what makes CI, a fresh worktree and this checkout resolve the
# same code. Ignoring it meant a third-party publish could turn main red with
# no commit of ours -- which is exactly what happened on 2026-08-05.

# Node.js
node_modules/
.next/
out/
.vercel
# apps/web migrated from pnpm to npm in 66b910f. The lockfile
# regenerates locally on a stray `pnpm install` and would drift
# from package-lock.json — CI uses npm.
apps/web/pnpm-lock.yaml

# Playwright (apps/web/tests-e2e)
apps/web/tests-e2e/.auth/
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
apps/web/playwright/.cache/
# Playwright sometimes lands its artefact dir at the repo root when
# the test is invoked from a different cwd (e.g. via the npm-workspace
# wrapper). Same purpose, same regeneration cycle — ignore here too.
/test-results/
/playwright-report/
# Catch-all for any `test-results/` Playwright lands under a non-
# canonical cwd (e.g. `apps/backend/` if a debugging session ran
# `npx playwright test` after `cd apps/backend && supabase status`).
# Per-test trace + screenshot + .last-run.json — never an artefact
# we want under version control.
**/test-results/

# Environment
.env
.env.local
.env.*.local
# The auto-started local edge runtime loads exactly one env file —
# `apps/backend/supabase/functions/.env` — on `supabase start`. Ours
# carries only committed non-secret local-stack values (the auth-email
# hook's local-dev signing secret + the Mailpit SMTP endpoint), same
# class as `.env.development`, so un-ignore it. Real keys stay in
# `.env.local`.
!apps/backend/supabase/functions/.env
# `.env.development` (committed local-dev defaults — local-stack values only:
# public Supabase demo keys + loopback URLs, no real secrets) is NOT matched by
# the patterns above, so it stays tracked everywhere. `.env.local` is your
# gitignored per-machine override that wins. See decisions §137.

# IDE
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store

# Xcode
xcuserdata/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Android
*.apk
*.aab
*.jks
*.keystore
local.properties
key.properties

# Firebase per-app config (FCM). Google does not treat either file as a secret,
# but both carry the project + app ids and a per-app API key and this repo is
# public, so they follow the upload keystore's pattern instead: durable copies
# sops-encrypted in the private estate repo, and the release workflows decode
# them from GOOGLE_SERVICES_JSON_BASE64 / GOOGLE_SERVICE_INFO_PLIST_BASE64.
google-services.json
GoogleService-Info.plist

# The FCM sender credential, which unlike the two config files above IS a
# secret: the Firebase Admin SDK key downloads as
# `<project>-firebase-adminsdk-<id>.json` and authorises sending as the
# project. It belongs in the estate repo and as a Fly secret, never on disk
# here — gitleaks would catch the private key, but not before it was written.
*firebase-adminsdk*.json
serviceAccountKey.json

# Supabase
.supabase/
/supabase/
apps/backend/supabase/.branches/
apps/backend/supabase/.temp/

# Claude Code runtime state (agents/, commands/ are checked in)
.claude/*.lock
.claude/settings.local.json
.claude/session-tasks.md
.claude/workflows/

# Local dev-services scratch: backgrounded job-worker binary + pid + log
# (written by bin/dev-full.sh — npm run dev:full).
.dev/

# Audit / review working notes — local-only, not committed (see reviews/README.md)
reviews/*
!reviews/README.md
# Safety net: stray finding artifacts belong in reviews/, but catch the legacy /
# ad-hoc locations so they can't be accidentally committed from the repo root.
persona-round*/
audit-findings-*.md

# Python bytecode cache (the .claude/hooks/*.py guards + their tests)
__pycache__/
*.pyc
