{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ %lld seconds": {
      "comment": "Spoken step duration over a minute: the already-spoken minutes, then the seconds. Matches the phone's ttsDurationMinutesSeconds in apps/mobile_android/lib/l10n/app_*.arb.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld Sekunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld segundos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld secondes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$lld秒"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld segundos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld segundos"
          }
        }
      }
    },
    "%@ kilometres": {
      "comment": "Spoken step distance in kilometres with one decimal, the number always written with a period so the voice reads it as a number. Matches the phone's ttsDistanceKm in apps/mobile_android/lib/l10n/app_*.arb.",
