{
  "sourceLanguage" : "en",
  "version" : "1.0",
  "strings" : {
    "Active Run" : {
      "comment" : "Complication display name shown in the watch-face editor.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiver Lauf" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Carrera activa" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Course en cours" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクティブなラン" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Corrida ativa" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Corrida ativa" } }
      }
    },
    "Live pace, distance, and elapsed time during a run." : {
      "comment" : "Complication description shown in the watch-face editor.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Live-Tempo, Distanz und verstrichene Zeit während eines Laufs." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ritmo, distancia y tiempo transcurrido en directo durante una carrera." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Allure, distance et temps écoulé en direct pendant une course." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ラン中のペース、距離、経過時間をリアルタイム表示。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ritmo, distância e tempo decorrido ao vivo durante uma corrida." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Ritmo, distância e tempo decorrido em direto durante uma corrida." } }
      }
    },
    "Begins a new run, starting GPS and heart-rate recording" : {
      "comment" : "VoiceOver hint on the Start button (pre-run screen).",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Startet einen neuen Lauf und beginnt die GPS- und Herzfrequenzaufzeichnung" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Inicia una nueva carrera y comienza a registrar el GPS y la frecuencia cardíaca" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Démarre une nouvelle course en activant le GPS et l'enregistrement de la fréquence cardiaque" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいランを開始し、GPSと心拍数の記録を始めます" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Inicia uma nova corrida, ativando o GPS e o registro da frequência cardíaca" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Inicia uma nova corrida, ativando o GPS e o registo da frequência cardíaca" } }
      }
    },
    "Cancel" : {
      "comment" : "Confirmation dialog button: dismiss without discarding.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Abbrechen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cancelar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Annuler" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キャンセル" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Cancelar" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Cancelar" } }
      }
    },
    "Clear route" : {
      "comment" : "Pre-run button that drops the route the phone pushed.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Route entfernen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Quitar ruta" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retirer l'itinéraire" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ルートを消去" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Remover rota" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Remover rota" } }
      }
    },
    "Clears this synced run from the watch and returns to the start screen" : {
      "comment" : "VoiceOver hint on the Start-next-run button.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Entfernt diesen synchronisierten Lauf von der Uhr und kehrt zum Startbildschirm zurück" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Borra esta carrera sincronizada del reloj y vuelve a la pantalla de inicio" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Efface cette course synchronisée de la montre et revient à l'écran de démarrage" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "同期済みのこのランをウォッチから消去し、開始画面に戻ります" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Remove esta corrida sincronizada do relógio e volta à tela inicial" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Remove esta corrida sincronizada do relógio e volta ao ecrã inicial" } }
      }
    },
    "DEBUG: Sync Direct" : {
      "comment" : "DEBUG-only button label; not user-facing in Release builds.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "DEBUG: Direkt synchronisieren" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "DEBUG: Sincronizar directo" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "DEBUG : Synchro directe" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "DEBUG: 直接同期" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "DEBUG: Sincronizar direto" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "DEBUG: Sincronizar direto" } }
      }
    },
    "Deletes the unsaved run permanently" : {
      "comment" : "VoiceOver hint on the Discard button (recovery screen).",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löscht den nicht gespeicherten Lauf endgültig" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elimina la carrera sin guardar de forma permanente" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprime définitivement la course non enregistrée" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "未保存のランを完全に削除します" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Exclui permanentemente a corrida não salva" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Elimina permanentemente a corrida não guardada" } }
      }
    },
    "Discard" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verwerfen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Descartar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "破棄" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Descartar" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Descartar" } }
      }
    },
    "Discard this run?" : {
      "comment" : "Confirmation dialog title before discarding an unsaved or unsynced run.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Lauf verwerfen?" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Descartar esta carrera?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer cette course ?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このランを破棄しますか？" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Descartar esta corrida?" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Eliminar esta corrida?" } }
      }
    },
    "Distance" : {
      "comment" : "Stat column header during a run.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Distanz" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Distancia" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Distance" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "距離" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Distância" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Distância" } }
      }
    },
    "HR" : {
      "comment" : "Heart-rate stat column header; short abbreviation.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "HF" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "FC" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "FC" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "心拍" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "FC" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "FC" } }
      }
    },
    "None — tap to set" : {
      "comment" : "Shown under the target-pace picker when no pace is selected.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine — zum Einstellen tippen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ninguno — toca para ajustar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucune — touchez pour définir" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "なし — タップして設定" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum — toque para definir" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum — toque para definir" } }
      }
    },
    "Not saved anywhere else" : {
      "comment" : "Confirmation dialog message: the run exists only on this watch.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nirgendwo sonst gespeichert" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se guarda en ningún otro sitio" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Enregistrée nulle part ailleurs" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "他に保存されていません" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não salva em nenhum outro lugar" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Não guardada em mais nenhum lado" } }
      }
    },
    "Off route" : {
      "comment" : "Off-route warning during a run when the deviation distance is momentarily unavailable. Wording matches Wear OS's off_route_distance.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Abseits der Route" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Fuera de ruta" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hors itinéraire" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ルート外" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Fora da rota" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Fora da rota" } }
      }
    },
    "Off route · %@" : {
      "comment" : "Off-route warning during a run; the placeholder is the deviation in metres.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Abseits der Route · %@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Fuera de ruta · %@" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hors itinéraire · %@" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ルート外 · %@" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Fora da rota · %@" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Fora da rota · %@" } }
      }
    },
    "Open the Run app" : {
      "comment" : "Complication subtitle when idle (rectangular family).",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Threkir öffnen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre la app Threkir" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir l'app Threkir" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Threkirアプリを開く" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abra o app Threkir" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Abra a app Threkir" } }
      }
    },
    "Pace" : {
      "comment" : "Pace stat column header; also complication corner label.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Tempo" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ritmo" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Allure" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペース" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ritmo" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Ritmo" } }
      }
    },
    "Pause" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Pause" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Pausar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pause" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "一時停止" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pausar" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Pausar" } }
      }
    },
    "Paused" : {
      "comment" : "Paused-screen title.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Pausiert" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "En pausa" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "En pause" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "一時停止中" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pausado" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Em pausa" } }
      }
    },
    "Pauses the recording without ending it" : {
      "comment" : "VoiceOver hint on the Pause button.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Pausiert die Aufzeichnung, ohne sie zu beenden" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Pausa el registro sin finalizarlo" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Met l'enregistrement en pause sans le terminer" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "記録を終了せずに一時停止します" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pausa o registro sem encerrá-lo" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Coloca o registo em pausa sem o terminar" } }
      }
    },
    "Queued — will retry" : {
      "comment" : "Sync status shown when the Watch Connectivity transfer is queued for retry.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "In Warteschlange — wird wiederholt" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "En cola — se reintentará" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "En file d'attente — nouvelle tentative" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キュー登録済み — 再試行します" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Na fila — vai tentar de novo" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Na fila — vai tentar novamente" } }
      }
    },
    "GPS track unavailable — synced without it" : {
      "comment" : "Shown after a successful sync when the run's recorded GPS trace was no longer on disk, so the run went up without its track.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "GPS-Track nicht verfügbar – ohne ihn synchronisiert" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Trazado GPS no disponible: sincronizado sin él" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tracé GPS indisponible – synchronisé sans lui" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "GPSトラックがありません。トラックなしで同期しました" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Trajeto GPS indisponível — sincronizado sem ele" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Trajeto GPS indisponível — sincronizado sem ele" } }
      }
    },
    "No GPS — time only" : {
      "comment" : "In-run banner while no GPS fix has landed yet — an indoor / treadmill run, not a failure.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein GPS — nur Zeit" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sin GPS — solo tiempo" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pas de GPS — durée seulement" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "GPS なし — 時間のみ" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Sem GPS — somente tempo" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Sem GPS — apenas tempo" } }
      }
    },
    "GPS lost" : {
      "comment" : "In-run banner after a fix landed and the signal then dropped.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "GPS verloren" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "GPS perdido" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "GPS perdu" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "GPS を喪失" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "GPS perdido" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "GPS perdido" } }
      }
    },
    "Heart rate unavailable" : {
      "comment" : "Shown during a run when the HealthKit workout session failed, so no further heart rate can be read.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Herzfrequenz nicht verfügbar" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Frecuencia cardíaca no disponible" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fréquence cardiaque indisponible" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "心拍数を取得できません" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Frequência cardíaca indisponível" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Frequência cardíaca indisponível" } }
      }
    },
    "Heart rate unavailable — run saved without it" : {
      "comment" : "Shown on the run summary when the HealthKit workout session failed mid-run; the run itself is intact but carries no average heart rate.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Herzfrequenz nicht verfügbar – Lauf ohne sie gespeichert" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Frecuencia cardíaca no disponible: carrera guardada sin ella" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fréquence cardiaque indisponible – course enregistrée sans elle" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "心拍数を取得できません。心拍数なしでランを保存しました" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Frequência cardíaca indisponível — corrida salva sem ela" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Frequência cardíaca indisponível — corrida guardada sem ela" } }
      }
    },
    "Phone unavailable — tap Sync Run to retry" : {
      "comment" : "Sync failure shown when WCSession has not finished activating; the run is kept for a manual retry.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Telefon nicht verfügbar – zum Wiederholen auf „Lauf synchronisieren“ tippen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Teléfono no disponible: toca Sincronizar carrera para reintentar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Téléphone indisponible – appuyez sur Synchroniser la course pour réessayer" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スマホに接続できません。「ランを同期」をタップして再試行" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Telefone indisponível — toque em Sincronizar corrida para tentar de novo" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Telemóvel indisponível — toque em Sincronizar corrida para tentar novamente" } }
      }
    },
    "Queued for sync" : {
      "comment" : "Sync status shown when the run is queued to transfer to the phone.",
