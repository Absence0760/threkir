<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Today widget reads the snapshot the host app's HomeWidgetBridge
	     writes, and an extension shares no container with its host except
	     through an App Group. The Live Activity needs nothing here: ActivityKit
	     carries its state. The id is centralised in TodayWidgetSnapshot.swift
	     as TodayWidget.appGroup and must match this file and
	     Runner.entitlements — TodayWidgetSnapshotTests compares all three. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.threkir.app.widget</string>
	</array>
</dict>
</plist>
